{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-titan.local/schema/titan-v1.0.json",
  "title": "Titan Schema v1.0",
  "type": "object",
  "required": ["meta", "morning_check", "sleep", "meals", "training", "nutrition", "history", "database_progress"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["date", "week", "day", "version", "timezone"],
      "properties": {
        "date": {"type": "string", "format": "date"},
        "week": {"type": "string"},
        "day": {"type": "string"},
        "version": {"const": "3.1"},
        "timezone": {"const": "Europe/Berlin"}
      }
    },
    "morning_check": {
      "type": "object",
      "required": ["weight_kg", "waist_cm", "training_readiness"],
      "properties": {
        "weight_kg": {"type": ["number", "null"], "minimum": 30, "maximum": 250},
        "waist_cm": {"type": ["number", "null"], "minimum": 40, "maximum": 200},
        "training_readiness": {"type": ["number", "null"], "minimum": 0, "maximum": 10},
        "muscle_recovery": {"type": ["string", "null"]},
        "stomach_status": {"type": ["string", "null"]},
        "mental_status": {"type": ["string", "null"]}
      }
    },
    "sleep": {
      "type": "object",
      "required": ["time_in_bed_minutes", "sleep_minutes", "efficiency_percent", "score", "heart_rate_bpm", "respiratory_rate", "deep_minutes", "light_minutes", "rem_minutes", "awakenings", "awake_minutes"],
      "properties": {
        "time_in_bed_minutes": {"type": "integer", "minimum": 0},
        "sleep_minutes": {"type": "integer", "minimum": 0},
        "efficiency_percent": {"type": "number", "minimum": 0, "maximum": 100},
        "score": {"type": "number", "minimum": 0, "maximum": 100},
        "heart_rate_bpm": {"type": "number", "minimum": 20, "maximum": 220},
        "respiratory_rate": {"type": "number", "minimum": 5, "maximum": 50},
        "deep_minutes": {"type": "integer", "minimum": 0},
        "light_minutes": {"type": "integer", "minimum": 0},
        "rem_minutes": {"type": "integer", "minimum": 0},
        "awakenings": {"type": "integer", "minimum": 0},
        "awake_minutes": {"type": "integer", "minimum": 0},
        "sleep_latency_minutes": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "meals": {
      "type": "object",
      "required": ["breakfast", "lunch", "dinner"],
      "properties": {
        "breakfast": {"$ref": "#/$defs/meal"},
        "lunch": {"$ref": "#/$defs/meal"},
        "dinner": {"$ref": "#/$defs/meal"}
      }
    },
    "training": {
      "type": "object",
      "required": ["start_time", "end_time", "body_parts", "exercises"],
      "properties": {
        "status": {"type": "string"},
        "type": {"type": "string"},
        "performed": {"type": "boolean"},
        "start_time": {"type": ["string", "null"], "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"},
        "end_time": {"type": ["string", "null"], "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"},
        "duration_minutes": {"type": ["integer", "null"], "minimum": 0},
        "notes": {"type": ["string", "null"]},
        "body_parts": {"type": "array", "items": {"type": "string"}},
        "exercises": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "sets"],
            "properties": {
              "name": {"type": "string"},
              "body_part": {"type": ["string", "null"]},
              "target": {"type": ["string", "null"]},
              "total_sets": {"type": ["integer", "null"], "minimum": 0},
              "working_sets": {"type": ["integer", "null"], "minimum": 0},
              "notes": {"type": ["string", "null"]},
              "sets": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["type"],
                  "properties": {
                    "set_no": {"type": ["integer", "null"], "minimum": 1},
                    "movement": {"type": ["string", "null"]},
                    "weight_kg": {"type": ["number", "null"], "minimum": 0},
                    "reps": {"type": ["integer", "null"], "minimum": 1},
                    "left_weight_kg": {"type": ["number", "null"], "minimum": 0},
                    "left_reps": {"type": ["integer", "null"], "minimum": 1},
                    "right_weight_kg": {"type": ["number", "null"], "minimum": 0},
                    "right_reps": {"type": ["integer", "null"], "minimum": 1},
                    "type": {"enum": ["warmup", "working"]},
                    "working_set": {"type": ["boolean", "null"]},
                    "rpe": {"type": ["number", "null"], "minimum": 0, "maximum": 10},
                    "note": {"type": ["string", "null"]}
                  }
                }
              }
            }
          }
        }
      }
    },
    "nutrition": {
      "type": "object",
      "required": ["estimated", "calories_kcal", "protein_g", "carbs_g", "fat_g", "targets"],
      "properties": {
        "estimated": {"type": "boolean"},
        "calories_kcal": {"type": ["number", "null"]},
        "protein_g": {"type": ["number", "null"]},
        "carbs_g": {"type": ["number", "null"]},
        "fat_g": {"type": ["number", "null"]},
        "targets": {
          "type": "object",
          "required": ["calories_kcal", "protein_g", "carbs_g", "fat_g"],
          "properties": {
            "calories_kcal": {"type": "number"},
            "protein_g": {"type": "number"},
            "carbs_g": {"type": "number"},
            "fat_g": {"type": "number"}
          }
        }
      }
    },
    "history": {"type": "array"},
    "database_progress": {"type": "object"},
    "meal_notes": {"type": "object"},
    "training_volume": {"type": "array"},
    "recovery_index": {"type": ["object", "null"]},
    "daily_summary": {"type": "object"},
    "discovery": {"type": "object"},
    "notes": {"type": ["string", "null"]}
  },
  "$defs": {
    "meal": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["food", "quantity"],
        "properties": {
          "food": {"type": "string"},
          "quantity": {"type": "string"}
        }
      }
    }
  }
}
